// Prisma schema — Banana Game
// Docs: https://www.prisma.io/docs/orm/prisma-schema/overview
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Theme: Virtual Identity ---
// Password is always stored as a bcrypt hash, never plaintext.
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())

  scores Score[]
}

// --- High score + leaderboard data (feature branch coming later) ---
model Score {
  id        Int      @id @default(autoincrement())
  score     Int
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([score])
  @@index([userId])
}